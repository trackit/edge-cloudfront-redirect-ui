# --- Node ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
.npm/

# --- Playwright (traces, screenshots, HTML report) ---
test-results/
playwright-report/
blob-report/
.playwright/

# --- Lambda@Edge baked config (rendered by Terraform at package time) ---
infra/lambda/src/edge-config.generated.ts

# --- Lambda@Edge zip (built by the edge module at apply time) ---
infra/modules/edge/.build/

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# The deployed environments' variable files are tracked: they hold names and
# flags, never credentials or cross-stack values, and the workflow needs them in
# the checkout. Everything else matching *.tfvars stays ignored, including the
# sandbox.tfvars a person copies from the .example files.
!deploy/*/*.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
