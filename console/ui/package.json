{
  "name": "@cloudfront-redirect-rules/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Console SPA — public landing page and (from the next tickets) the rules console.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts && prettier --write src/api/schema.gen.ts",
    "generate:api:check": "npm run generate:api && git diff --exit-code -- src/api/schema.gen.ts",
    "generate:countries": "tsx scripts/generate-countries.ts && prettier --write src/countries.gen.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
