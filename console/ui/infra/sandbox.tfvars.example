# Copy to sandbox.tfvars, fill in, and pass it explicitly:
#
#   terraform apply -var-file=sandbox.tfvars
#
# Not terraform.tfvars: Terraform auto-loads that name, including when running
# `terraform test`, where it would override the defaults the suite asserts on.
# Both names are gitignored (*.tfvars); this .example is the tracked one, so keep
# real values out of it.

# The `api_endpoint` output of console/api/infra. Host only, no path.
api_endpoint = "https://REPLACE_ME.execute-api.us-east-1.amazonaws.com"

# Sign-in, from the same stack's `cognito_domain` and `user_pool_client_id`
# outputs. Both are baked into the SPA at build time, and neither is a secret —
# the client id travels in every authorize URL, and the client secret it pairs
# with stays in the API's Lambda.
#
# Cognito only redirects back to a URL it has been told about, so the pool's
# `auth_callback_urls` needs this console's https://<domain>/auth/callback in it.
# That domain does not exist until this stack has applied, which is why it is a
# second apply of console/api/infra rather than a value you can set up front.
cognito_domain    = "https://REPLACE_ME.auth.us-east-1.amazoncognito.com"
cognito_client_id = "REPLACE_ME"

# The basic-auth credential the console prompts for. Login is post-MVP; this is
# what keeps an unauthenticated console off the open internet.
#
# It is rendered into the CloudFront Function's code and stored in state, and
# anyone with cloudfront:GetFunction can read it back. Treat it as a demo
# credential: don't reuse a password from anywhere else.
basic_auth_username = "demo"
basic_auth_password = "REPLACE_ME_at_least_12_chars"

# `npm ci` at the repo root deletes and reinstalls node_modules, which wipes your
# working install mid-apply. "npm install" keeps it; "" skips installing entirely
# and builds with whatever is there.
npm_install_command = "npm install"

tags = {
  project = "edgeroute"
  env     = "sandbox"
}
